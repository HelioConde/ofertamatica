RewriteEngine On

# Compactação HTTP: o Lighthouse detectou JS/CSS servidos sem gzip/br.
# mod_deflate é opcional na hospedagem: não falha caso o módulo não exista.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript text/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/ld+json application/xml image/svg+xml
</IfModule>

# Arquivos do Vite com hash no nome podem ficar no cache por um ano.
# HTML, sitemap e manifestos permanecem revalidáveis em cada atualização.
<IfModule mod_headers.c>
  # Cabeçalhos básicos sem CSP restritiva (AdSense/GTM continuam funcionais).
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), camera=(), microphone=()"
  Header always set Strict-Transport-Security "max-age=31536000"
  <FilesMatch "-[A-Za-z0-9_-]{8,}\.(js|css|png|jpg|jpeg|webp|woff2?|otf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html|xml|txt|json)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>


# One canonical HTTPS host. Preserve the full request path.
RewriteCond %{HTTP_HOST} ^www\.ofertamatica\.com\.br$ [NC]
RewriteRule ^ https://ofertamatica.com.br%{REQUEST_URI} [R=301,L,NE]

# Canonicalise legacy URLs that still receive impressions from Google.
RewriteRule ^criar-placas/?$ / [R=301,L]
RewriteRule ^cartaz-de-oferta-gratis/?$ /criador-de-cartaz-de-oferta/ [R=301,L]
RewriteRule ^cartaz-supermercado-online/?$ /cartaz-para-supermercado/ [R=301,L]
RewriteRule ^placa-de-preco-supermercado/?$ /cartaz-de-preco-online/ [R=301,L]
RewriteRule ^gerador-de-cartaz-com-ia/?$ /como-funciona/ [R=301,L]
RewriteRule ^cartaz-de-supermercado/?$ /cartaz-para-supermercado/ [R=301,L]
RewriteRule ^cartaz-para-imprimir/?$ /cartaz-de-oferta-para-imprimir/ [R=301,L]
RewriteRule ^gerador-de-placas-com-ia/?$ /como-funciona/ [R=301,L]
RewriteRule ^cartazes-para-supermercado/?$ /cartaz-para-supermercado/ [R=301,L]
RewriteRule ^cartaz-supermercado/?$ /cartaz-para-supermercado/ [R=301,L]
RewriteRule ^cartazes-para-promocao/?$ /gerador-de-cartaz-de-promocao/ [R=301,L]
RewriteRule ^gerador-de-placas-promocionais/?$ /gerador-de-cartaz-de-promocao/ [R=301,L]
RewriteRule ^gerador-de-cartaz-gratis/?$ /criador-de-cartaz-de-oferta/ [R=301,L]
RewriteRule ^como-criar-cartazes-promocionais/?$ /como-fazer-cartaz-de-oferta/ [R=301,L]
RewriteRule ^guias/?$ /guias-para-varejo/ [R=301,L]
RewriteRule ^faq/?$ /como-funciona/ [R=301,L]
RewriteRule ^modelos-de-placas/?$ /modelos/ [R=301,L]
RewriteRule ^modelos/[^/]+/?$ /modelos/ [R=301,L]
RewriteRule ^excel-para-cartazes/?$ /cartazes-a-partir-de-excel/ [R=301,L]
RewriteRule ^importar-produtos-excel/?$ /cartazes-a-partir-de-excel/ [R=301,L]
RewriteRule ^ia-para-promocoes/?$ /como-funciona/ [R=301,L]

# Old account pages are no longer functional: do not serve a misleading home page.
RewriteRule ^(login|registro)/?$ - [G,L]

# Existing SEO pages, assets, service-worker files and API files are served normally.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Unknown paths must return a real 404, not an HTTP 200 with homepage canonical.
RewriteRule ^ - [R=404,L]
