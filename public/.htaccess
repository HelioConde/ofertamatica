RewriteEngine On

# Erros reais com conteúdo útil: preserva HTTP 404/410, sem redirecionar para a home.
# O ErrorDocument interno mantém o status original para Googlebot e navegador.
ErrorDocument 404 /404.html
ErrorDocument 410 /404.html

# Biblioteca de funções PHP usada apenas por includes internos.
RewriteRule ^api/_stats\.php$ - [F,L]

# Compactação HTTP: o Lighthouse detectou JS/CSS servidos sem gzip/br.
# mod_deflate é opcional na hospedagem: não falha caso o módulo não exista.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript text/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/ld+json application/xml image/svg+xml
</IfModule>

# Arquivos do Vite com hash no nome podem ficar no cache por um ano.
# HTML, sitemap e manifestos permanecem revalidáveis em cada atualização.
<IfModule mod_headers.c>
  # Cabeçalhos básicos sem CSP restritiva (AdSense/GTM continuam funcionais).
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), camera=(), microphone=()"
  Header always set Strict-Transport-Security "max-age=31536000"
  <FilesMatch "-[A-Za-z0-9_-]{8,}\.(js|css|png|jpg|jpeg|webp|woff2?|otf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html|xml|txt|json)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>


# One canonical HTTPS host. Preserve the full request path.
RewriteCond %{HTTP_HOST} ^www\.ofertamatica\.com\.br$ [NC]
RewriteRule ^ https://ofertamatica.com.br%{REQUEST_URI} [R=301,L,NE]

# Canonicalise legacy URLs that still receive impressions from Google.
RewriteRule ^criar-placas/?$ / [R=301,L]
RewriteRule ^cartaz-de-oferta-gratis/?$ /criador-de-cartaz-de-oferta/ [R=301,L]
RewriteRule ^cartaz-supermercado-online/?$ /cartaz-para-supermercado/ [R=301,L]
RewriteRule ^placa-de-preco-supermercado/?$ /cartaz-de-preco-online/ [R=301,L]
RewriteRule ^gerador-de-cartaz-com-ia/?$ /como-funciona/ [R=301,L]
RewriteRule ^cartaz-de-supermercado/?$ /cartaz-para-supermercado/ [R=301,L]
RewriteRule ^cartaz-para-imprimir/?$ /cartaz-de-oferta-para-imprimir/ [R=301,L]
RewriteRule ^gerador-de-placas-com-ia/?$ /como-funciona/ [R=301,L]
RewriteRule ^cartazes-para-supermercado/?$ /cartaz-para-supermercado/ [R=301,L]
RewriteRule ^placas-para-supermercado/?$ /cartaz-para-supermercado/ [R=301,L]
RewriteRule ^placas-para-acougue/?$ /cartazes-para-acougue/ [R=301,L]
RewriteRule ^cartaz-supermercado/?$ /cartaz-para-supermercado/ [R=301,L]
RewriteRule ^cartazes-para-promocao/?$ /gerador-de-cartaz-de-promocao/ [R=301,L]
RewriteRule ^gerador-de-placas-promocionais/?$ /gerador-de-cartaz-de-promocao/ [R=301,L]
RewriteRule ^gerador-de-cartaz-gratis/?$ /criador-de-cartaz-de-oferta/ [R=301,L]
RewriteRule ^como-criar-cartazes-promocionais/?$ /como-fazer-cartaz-de-oferta/ [R=301,L]
RewriteRule ^guias/?$ /guias-para-varejo/ [R=301,L]
RewriteRule ^faq/?$ /como-funciona/ [R=301,L]
RewriteRule ^modelos-de-placas/?$ /modelos/ [R=301,L]
RewriteRule ^modelos/[^/]+/?$ /modelos/ [R=301,L]
RewriteRule ^excel-para-cartazes/?$ /cartazes-a-partir-de-excel/ [R=301,L]
RewriteRule ^importar-produtos-excel/?$ /cartazes-a-partir-de-excel/ [R=301,L]
RewriteRule ^ia-para-promocoes/?$ /como-funciona/ [R=301,L]

# Recuperação de endereços antigos identificados no Search Console (soft 404 em 12/10/2026).
# Usar 301 somente quando há conteúdo equivalente, evitando levar todo tráfego para a home.
RewriteRule ^ferramenta-para-cartazes/?$ /criador-de-cartaz-de-oferta/ [R=301,L]
RewriteRule ^como-fazer-cartaz-de-supermercado/?$ /como-fazer-cartaz-de-oferta/ [R=301,L]
RewriteRule ^cartaz-promocional/?$ /gerador-de-cartaz-de-promocao/ [R=301,L]
RewriteRule ^cartaz-padaria/?$ /placas-para-padaria/ [R=301,L]
RewriteRule ^placa-para-imprimir/?$ /cartaz-de-oferta-para-imprimir/ [R=301,L]
RewriteRule ^cartaz-para-imprimir-gratis/?$ /cartaz-de-oferta-para-imprimir/ [R=301,L]
RewriteRule ^placa-promocional/?$ /gerador-de-cartaz-de-promocao/ [R=301,L]
RewriteRule ^placa-mercado/?$ /cartaz-para-supermercado/ [R=301,L]
RewriteRule ^como-criar-placas-de-oferta/?$ /como-fazer-cartaz-de-oferta/ [R=301,L]
RewriteRule ^placas-hortifruti/?$ /placas-para-hortifruti/ [R=301,L]
RewriteRule ^cartaz-mercado/?$ /cartaz-para-supermercado/ [R=301,L]
RewriteRule ^cartaz-online-gratis/?$ /criador-de-cartaz-de-oferta/ [R=301,L]
RewriteRule ^cartaz-a4-1x1/?$ /cartaz-a4/ [R=301,L]
RewriteRule ^cartazes-prontos-para-impressao/?$ /modelos/ [R=301,L]
RewriteRule ^cartazes-prontos/?$ /modelos/ [R=301,L]
RewriteRule ^cartaz-promocional-gratis/?$ /gerador-de-cartaz-de-promocao/ [R=301,L]
RewriteRule ^placa-de-preco/?$ /cartaz-de-preco-online/ [R=301,L]
RewriteRule ^modelos-de-cartazes/?$ /modelos/ [R=301,L]
RewriteRule ^placas-prontas-para-impressao/?$ /modelos/ [R=301,L]
RewriteRule ^placa-de-oferta/?$ /criador-de-cartaz-de-oferta/ [R=301,L]
RewriteRule ^automacao-de-cartazes/?$ /cartazes-a-partir-de-excel/ [R=301,L]
RewriteRule ^placa-de-promocao/?$ /gerador-de-cartaz-de-promocao/ [R=301,L]
RewriteRule ^placa-promocional-gratis/?$ /gerador-de-cartaz-de-promocao/ [R=301,L]
RewriteRule ^cartaz-a4-4x1/?$ /cartaz-a4/ [R=301,L]
RewriteRule ^placa-supermercado/?$ /cartaz-para-supermercado/ [R=301,L]
RewriteRule ^cartaz-amarelo/?$ /modelos/ [R=301,L]
RewriteRule ^cartaz-promocao/?$ /gerador-de-cartaz-de-promocao/ [R=301,L]

# URLs equivalentes identificadas na exportação GSC de 22/10/2026 (404).
# Não redirecionar páginas de IA/SRA3 sem conteúdo equivalente publicado.
RewriteRule ^placas-promocionais/?$ /gerador-de-cartaz-de-promocao/ [R=301,L]
RewriteRule ^cartaz-de-oferta/?$ /criador-de-cartaz-de-oferta/ [R=301,L]
RewriteRule ^placas-para-farmacia/?$ /cartazes-para-farmacia/ [R=301,L]
RewriteRule ^placa-2x1/?$ /formatos/ [R=301,L]

# Campanha descontinuada sem conteúdo equivalente: HTTP 410 real (não soft 404).
RewriteRule ^cartaz-copa-do-mundo/?$ - [G,L]

# Old account pages are no longer functional: do not serve a misleading home page.
RewriteRule ^(login|registro)/?$ - [G,L]

# Existing SEO pages, assets, service-worker files and API files are served normally.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Unknown paths must return a real 404, not an HTTP 200 with homepage canonical.
RewriteRule ^ - [R=404,L]
